# Modèle de variables d'environnement pour Mali Connecte
# Ne jamais commiter le fichier .env réel contenant les vraies valeurs !

PG_PASS=votre_mot_de_passe_postgres_robuste
PG_USER=authentik
PG_DB=authentik
AUTHENTIK_SECRET_KEY=cle_secrete_aleatoire_base64_50_caracteres

# Configuration SMTP (ex: Brevo / Resend) - optionnel au démarrage
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre_identifiant_smtp
SMTP_PASSWORD=votre_cle_smtp
SMTP_FROM=Mali Connecte <contact@malihub.digital>
